# Set these in Vercel → Project → Settings → Environment Variables.

# Stripe secret key. Use sk_test_... until you are ready to take real payments.
STRIPE_SECRET_KEY=sk_test_xxx

# Password for the team area at /admin. Use a long, unique one.
ADMIN_PASSWORD=change-me

# Added automatically when you connect a Vercel Blob store (Storage tab).
BLOB_READ_WRITE_TOKEN=
